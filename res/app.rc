/*
 * app.rc — Recursos do LiteSic
 *
 * Manifest (DPI awareness + compatibilidade Win7-11), ícone e VERSIONINFO.
 */

/* Manifest de processo (CREATEPROCESS_MANIFEST_RESOURCE_ID = 1, RT_MANIFEST = 24) */
1 24 "app.manifest"

/* Ícone da aplicação (ID 101 — deve bater com IDI_APP_ICON em mainwnd.h) */
101 ICON "icon.ico"

/* Informações de versão */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "LiteSic"
            VALUE "FileDescription",  "LiteSic - Winamp-like audio player"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "LiteSic"
            VALUE "LegalCopyright",   "LiteSic project"
            VALUE "OriginalFilename", "LiteSic.exe"
            VALUE "ProductName",      "LiteSic"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
